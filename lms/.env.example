APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Production (Render + Aiven) — critical for <5s loads:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://YOUR-SERVICE.onrender.com
#   LOG_CHANNEL=stderr
#   LOG_LEVEL=error
#   LOG_REQUEST_TIMING=true          # temporary: logs total_ms / db_ms / queries
#   SESSION_DRIVER=file
#   CACHE_DRIVER=file
#   QUEUE_CONNECTION=sync
#   SESSION_SECURE_COOKIE=true
#   RUN_MIGRATIONS=false             # true ONLY once after schema/index changes
#   CACHE_VIEWS_ON_BOOT=false
#   DB_CONNECTION=mysql              # this app uses MySQL (pdo_mysql). Aiven MySQL OK.
#   DB_PERSISTENT=true               # reuse TLS connections on Apache workers
#   DB_CONNECT_TIMEOUT=5
#   DB_READ_TIMEOUT=15
#   MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# Put Render web + Aiven DB in the SAME region. Cross-region RTT × query count
# is the usual 10–20s login/dashboard delay.
# Prefer Aiven connection pooler endpoint/port when available.
# Render free tier sleeps — first hit after idle is cold start (not app latency).
# Use a paid always-on instance for consistent <5s.
# Optional Redis: CACHE_DRIVER=redis + SESSION_DRIVER=redis
# ---------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_school
DB_USERNAME=root
DB_PASSWORD=

# Remote MySQL (Aiven/Railway): persistent connections skip TLS handshake on reused Apache workers.
# Auto-enabled when DB_HOST is not localhost. Set false if SSL persistent connections fail.
# DB_PERSISTENT=true
# DB_CONNECT_TIMEOUT=5
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
